  "textbookMaterial": {
    "geometry": {
      "explanation": "关节origin给出父link到关节零位坐标的安装变换，axis在该关节局部坐标表达。转动时先在关节局部轴上施加q，再经origin转到父系；固定joint没有可变q。visual/collision/inertial各自还能有相对link的origin，这些不会自动把关节axis旋到相同位置。",
      "equation": "T_parent_child(q)=T_origin*T_motion(axis_joint,q)",
      "units": {
        "xyz": "m",
        "rpy/revolute/continuous position": "rad",
        "prismatic position": "m",
        "mass": "kg",
        "inertia": "kg*m^2"
