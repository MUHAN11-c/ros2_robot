  "textbookMaterial": {
    "lifecycle": {
      "explanation": "LifecycleNode的状态机、LifecyclePublisher的激活标志与应用资源是三个层次。成功configure后inactive，成功activate后active；FAILURE回到原先可恢复主状态；ERROR及捕获的标准异常进入on_error。默认C状态机将on_error SUCCESS送回unconfigured，FAILURE/ERROR送finalized。原回调ERROR仍使原ChangeState.success为false，后续恢复并不篡改原请求结果。",
      "tableColumns": [
        "原回调",
        "on_error",
        "最终状态",
        "原请求success",
        "资源责任"
      ],
      "tableRows": [
        [
          "configure FAILURE",
          "不调用",
          "unconfigured",
          "false",
          "候选释放/旧配置元数据由实现保留"
        ],
        [
          "activate FAILURE",
          "不调用",
          "inactive",
          "false",
          "已配置资源由实现保留"
        ],
        [
          "ERROR/std::exception",
          "SUCCESS",
          "unconfigured",
          "false",
          "on_error显式清理后才可重配"
        ],
        [
          "ERROR/std::exception",
          "FAILURE或ERROR",
          "finalized",
          "false",
          "终结标签不代替清理"
        ]
      ],
      "boundary": "本例显式撤销on_error/on_shutdown中的activation flag和假资源工作。普通timer/Publisher不自动暂停；进程SIGINT析构不是标准shutdown转换。"
    },
    "testing": {
      "explanation": "ReadyToTest允许测试线程开始，不检查业务就绪。本包独立等待READY、输入端点及真实5/7→0/0输出，再在post-shutdown查exit0。CTest注册项、细分JUnit和CLI汇总包含包装层，分别记录3、13、16。已注册测试失败可让默认colcon test返回0，strict选项或test-result与当次XML另查；空结果查询0仍必须拒绝验收。",
      "boundary": "预期故障被捕获表示教学实验有效，不代表故障软件通过。31策略测试只证明列出的整数纳秒/有限速度合同；未测helper异常清理分支不能用正常退出顶替。"
    },
    "deployment": {
      "explanation": "显式安装前缀清点必须把普通文件SHA、symlink文本/目标和underlay分开。副本字节一致仍可引用原source/build/ROS前缀。ELF直接依赖清单不等于全部依赖闭包；没有外链也不推出ABI、架构、Python、配置满足。shell exec替换到指定命令；指定CLI仍可能再建节点子进程，应查实际PID、信号、退出和孩子。",
      "boundary": "宿主一次TERM正例不替代Docker stop；当前没有Docker命令、没有拉镜像、没有运行副本/目标机。镜像定义commit、registry摘要、image ID和tarSHA各自记录。"
    }
  },
