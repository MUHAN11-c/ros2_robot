<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.9">
  <world name="hub_navigation_execution">
    <physics name="lab_step" type="ignored">
      <max_step_size>0.005</max_step_size><real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    
    <model name="map_west">
      <static>true</static><pose>-3.5 0 0.5 0 0 0</pose>
      <link name="wall">
        <visual name="appearance"><geometry><box><size>0.20 5.20 1.0</size></box></geometry></visual>
        <collision name="shape"><geometry><box><size>0.20 5.20 1.0</size></box></geometry></collision>
      </link>
    </model>
    <model name="map_east">
      <static>true</static><pose>3.5 0 0.5 0 0 0</pose>
      <link name="wall">
        <visual name="appearance"><geometry><box><size>0.20 5.20 1.0</size></box></geometry></visual>
        <collision name="shape"><geometry><box><size>0.20 5.20 1.0</size></box></geometry></collision>
      </link>
    </model>
    <model name="map_north">
      <static>true</static><pose>0 2.5 0.5 0 0 0</pose>
      <link name="wall">
        <visual name="appearance"><geometry><box><size>7.20 0.20 1.0</size></box></geometry></visual>
        <collision name="shape"><geometry><box><size>7.20 0.20 1.0</size></box></geometry></collision>
      </link>
    </model>
    <model name="map_south">
      <static>true</static><pose>0 -2.5 0.5 0 0 0</pose>
      <link name="wall">
        <visual name="appearance"><geometry><box><size>7.20 0.20 1.0</size></box></geometry></visual>
        <collision name="shape"><geometry><box><size>7.20 0.20 1.0</size></box></geometry></collision>
      </link>
    </model>
    
    <model name="map_pillar">
      <static>true</static><pose>1.65 1.55 0.5 0 0 0</pose>
      <link name="pillar">
        <visual name="appearance"><geometry><box><size>0.60 0.70 1.0</size></box></geometry></visual>
        <collision name="shape"><geometry><box><size>0.60 0.70 1.0</size></box></geometry></collision>
      </link>
    </model>
    <model name="observation_box">
      <static>true</static><pose>0.05 0 0.5 0 0 0</pose>
      <link name="box">
        <visual name="appearance"><geometry><box><size>0.60 0.80 1.0</size></box></geometry></visual>
        <collision name="shape"><geometry><box><size>0.60 0.80 1.0</size></box></geometry></collision>
      </link>
    </model>
    <model name="floor"><static>true</static><link name="floor_link">
        <collision name="surface"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry></collision>
        <visual name="surface"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry></visual>
      </link></model><model name="nav_cart">
    <pose>-2.10 -1.35 0.091 0 0 0</pose>
    <link name="base_link">
      
      <inertial>
        <pose>-0.052 0 0.038 0 0 0</pose><mass>3.2</mass>
        <inertia><ixx>0.023</ixx><iyy>0.042</iyy><izz>0.054</izz></inertia>
      </inertial>
      <collision name="body">
        <pose>-0.026 0 0.043 0 0 0</pose><geometry><box><size>0.34 0.26 0.09</size></box></geometry>
      </collision>
      <visual name="body">
        <pose>-0.026 0 0.043 0 0 0</pose><geometry><box><size>0.34 0.26 0.09</size></box></geometry>
        <material><ambient>0.36 0.44 0.68 1</ambient><diffuse>0.36 0.44 0.68 1</diffuse></material>
      </visual>
      
      <sensor name="navigation_scan" type="gpu_lidar">
        <pose>0 0 0.21 0 0 0</pose>
        <topic>/hub_execute/scan</topic><update_rate>10</update_rate><always_on>true</always_on>
        <lidar>
          <scan><horizontal><samples>361</samples><resolution>1</resolution>
            <min_angle>-3.141592653589793</min_angle><max_angle>3.141592653589793</max_angle>
          </horizontal></scan>
          <range><min>0.10</min><max>8.0</max><resolution>0.01</resolution></range>
        </lidar>
      </sensor>
    </link>
    <link name="left_wheel">
      <pose>0 0.16 0 0 0 0</pose>
      <inertial><mass>0.25</mass><inertia><ixx>0.00054</ixx><iyy>0.00101</iyy><izz>0.00054</izz></inertia></inertial>
      <collision name="tire">
        <pose>0 0 0 1.5707963267948966 0 0</pose>
        <geometry><cylinder><radius>0.09</radius><length>0.040</length></cylinder></geometry>
        <surface><friction><ode><mu>1.1</mu><mu2>1.1</mu2></ode></friction></surface>
      </collision>
      <visual name="tire">
        <pose>0 0 0 1.5707963267948966 0 0</pose>
        <geometry><cylinder><radius>0.09</radius><length>0.040</length></cylinder></geometry>
      </visual>
    </link>
    <link name="right_wheel">
      <pose>0 -0.16 0 0 0 0</pose>
      <inertial><mass>0.25</mass><inertia><ixx>0.00054</ixx><iyy>0.00101</iyy><izz>0.00054</izz></inertia></inertial>
      <collision name="tire">
        <pose>0 0 0 1.5707963267948966 0 0</pose>
        <geometry><cylinder><radius>0.09</radius><length>0.040</length></cylinder></geometry>
        <surface><friction><ode><mu>1.1</mu><mu2>1.1</mu2></ode></friction></surface>
      </collision>
      <visual name="tire">
        <pose>0 0 0 1.5707963267948966 0 0</pose>
        <geometry><cylinder><radius>0.09</radius><length>0.040</length></cylinder></geometry>
      </visual>
    </link>
    <link name="caster">
      
      <pose>-0.19 0 -0.056 0 0 0</pose>
      <inertial><mass>0.11</mass><inertia><ixx>0.000051</ixx><iyy>0.000051</iyy><izz>0.000051</izz></inertia></inertial>
      <collision name="ball"><geometry><sphere><radius>0.034</radius></sphere></geometry>
        <surface><friction><ode><mu>0.32</mu><mu2>0.32</mu2></ode></friction></surface>
      </collision>
      <visual name="ball"><geometry><sphere><radius>0.034</radius></sphere></geometry></visual>
    </link>
    
    <joint name="left_wheel_joint" type="revolute">
      <parent>base_link</parent><child>left_wheel</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>
    <joint name="right_wheel_joint" type="revolute">
      <parent>base_link</parent><child>right_wheel</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>
    <joint name="caster_joint" type="ball"><parent>base_link</parent><child>caster</child></joint>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint><right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.32</wheel_separation><wheel_radius>0.09</wheel_radius>
      <topic>/hub_execute/cmd</topic>
      <odom_topic>/hub_execute/wheel_odom</odom_topic><tf_topic>/hub_execute/wheel_tf</tf_topic>
      <frame_id>odom</frame_id><child_frame_id>base_link</child_frame_id><odom_publish_frequency>50</odom_publish_frequency>
    </plugin>
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>gazebo_world</odom_frame><robot_base_frame>gazebo_cart</robot_base_frame>
      <odom_topic>/hub_execute/world_pose</odom_topic><odom_publish_frequency>50</odom_publish_frequency>
      <dimensions>3</dimensions>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/hub_execute/joints</topic><joint_name>left_wheel_joint</joint_name><joint_name>right_wheel_joint</joint_name>
    </plugin>
  </model>
</world>
</sdf>