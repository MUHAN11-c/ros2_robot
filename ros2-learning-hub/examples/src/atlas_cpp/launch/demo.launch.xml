<!-- 【中文教学注释】 examples/src/atlas_cpp/launch/demo.launch.xml -->
<!-- 输入输出：输入为 launch 参数、包内文件路径和 YAML 配置；输出为具有指定命名空间、重映射和参数的节点进程。 -->
<!-- 执行顺序与边界：launch 描述在启动阶段解释，动作书写顺序不等于应用已就绪；相对话题继承命名空间，参数文件顶层节点名必须匹配实际节点。 -->
<launch>
  <!-- 声明待启动节点的包、可执行入口和名称；属性可分多行，启动动作顺序不是应用就绪屏障。 -->
  <node pkg="atlas_cpp" exec="talker" namespace="atlas" name="talker" output="screen"/>
  <node pkg="atlas_py" exec="listener" namespace="atlas" name="listener" output="screen"/>
</launch>
