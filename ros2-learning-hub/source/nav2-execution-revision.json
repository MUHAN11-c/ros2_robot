    "eco-nav2-task-programming": {
      "validation": "有界客户端仍有独立假服务端验证。实际行为树与下级动作：本机 Jazzy Nav2 1.3.13、Harmonic 8.15.0、ros_gz_bridge 1.0.24 实测。主试验域 223，实际解压示例和地图后在域 224 重跑。范围为静态房间的单机器人仿真。本轮验证五个任务分支和停稳。多目标调度、抢占及硬件待验。",
      "appendSourceIds": [
        "navexec-action-fields",
        "navexec-status",
        "navexec-selector",
        "navexec-bt-actions",
        "navexec-community"
      ],
      "appendSections": [
        {
          "title": "按目标 UUID 核对上层、下级和取消回执",
          "paragraphs": [
            "发送标准 NavigateToPose 目标，behavior_tree 字段留空以使用安装版默认树。记录目标响应、持续反馈、取消响应和最终业务结果。上层有自己的目标 UUID，规划器和控制器的子目标也各自有独立 UUID。",
            "取消试验先通过世界位姿确认车辆平移，再按当前目标 UUID 发送取消。上层终态在请求后约 0.025 s 收到。下级 FollowPath 的最后终态也是 CANCELED。停止证据来自后续轮反馈与世界位姿。",
            "越界目标在规划阶段返回 204，无效控制器在成功规划后由 FollowPath 返回 101。恢复有效控制器 ID 后，同一地图系目标可重新到达。目标是否被接受、动作状态和业务码需要分别记录。",
            "本章的通用有界客户端只依赖公开动作协议。台架为诊断订阅子动作状态主题，从真实 UUID 读取最近一次终态的详细结果。行为树事件的发布批次和内部时间分别保留。"
          ],
          "bullets": [],
          "tables": [
            {
              "title": "上层动作与下级动作的实测终态",
              "columns": [
                "场景",
                "目标响应",
                "上层终态",
                "上层业务码",
                "下级终态与业务码"
              ],
              "rows": [
                [
                  "正常到达",
                  "接受",
                  "SUCCEEDED",
                  "0",
                  "compute_path_to_pose SUCCEEDED / 0；follow_path SUCCEEDED / 0"
                ],
                [
                  "途中取消",
                  "接受",
                  "CANCELED",
                  "0",
                  "compute_path_to_pose SUCCEEDED / 0；follow_path CANCELED / 0"
                ],
                [
                  "越界目标",
