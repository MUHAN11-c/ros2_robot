  "chapters": {
    "eco-gazebo-simulation": {
      "appendSourceIds": [
        "sensor-gz-world",
        "sensor-bridge-config",
        "sensor-control",
        "sensor-template"
      ],
      "validation": "在本机 Gazebo Sim, version 8.15.0 与 Jazzy ros_gz_bridge 1.0.24，域 227/LOCALHOST、独立 Gazebo Transport 分区实际运行。通过无窗口 EGL Ogre2 实测时钟、传感器、世界控制和暂停恢复。范围为固定模拟相机、激光和实际桥接，GUI、实机、SLAM、Nav2 和底盘仿真由其他实验验收。",
      "appendSections": [
        {
          "title": "在本地小世界实测单向桥与暂停恢复",
          "paragraphs": [
            "把 SDF 中的物理系统和 Sensors 系统分开观察。步长为 0.005 s，传感器配置 10 Hz。模型只由本地几何构成，ROS 端取得图像、内参、激光和点云之后再谈算法。",
            "官方工程模板把速度命令放在 ROS 到 Gazebo 的方向，并把时钟、里程计和扫描放在反向。本例从世界专属 /world/hub_perception/clock 转发到 ROS /clock，五条数据映射实际查到桥发布端和单向图结构。ControlWorld 走单独服务路径，响应成功后还要检查时钟是否推进。",
            "SDF 只描述仿真中的数据。桥的 ROS 类型、QoS 和命名空间由 YAML 显式给出，传感器 frame_id 与下游提供的 TF 逐一配对。原始 Header 保持仿真采集时间。本机无窗口运行选择了可用的 EGL vendor，先前的软件 EGL 路径在驱动初始化阶段失败。"
          ],
          "bullets": [],
          "tables": [
            {
              "title": "同一真实仿真世界的时钟和采样",
              "columns": [
                "阶段",
                "ROS 时间（s）",
                "采样与控制回执"
              ],
              "rows": [
                [
                  "初始暂停",
                  "0",
                  "桥已发现，时间尚未推进"
                ],
                [
                  "运行",
                  "0.655",
                  "ControlWorld 恢复成功，收到图像与激光"
                ],
                [
                  "暂停",
                  "0.660",
                  "排空队列后观察 0.40 单调秒，五类采样时戳不变"
                ],
                [
                  "再恢复",
                  "0.700",
                  "服务回执成功，时钟与五类采样时戳推进"
                ]
              ],
              "caption": "三处非零值取自这一轮采样。暂停窗口以单调时钟测量，不能用冻结的仿真时间限时。",
              "evidenceFile": "validation-evidence/gazebo-sensors-current-validation.json",
              "evidenceSha256": "697c865879d240e7e9266488b308d7a6d7f88f5df9a3527230f03303d6b60686"
            }
          ],
          "codeBlocks": [
            {
              "label": "运行 Gazebo 传感器实验",
              "language": "bash",
              "type": "commands",
              "code": "# 在 ros2-learning-hub 目录执行，需已安装 Jazzy、Harmonic、ros_gz_bridge 与 cv_bridge。\nsource /opt/ros/jazzy/setup.bash\n# 输入是本地小世界和桥映射。227 为隔离本机 DDS 域。结果写到新建 /tmp 目录。\npython3 examples/gazebo_labs/validate_sensors.py --domain-id 227\n# Ogre2 若无法创建 EGL 上下文，可用 --egl-vendor-json 指向本机有效的 vendor JSON。",
              "explanation": "先在暂停世界发现服务和端点，再让真实世界运行并核对时钟、相机、点云与 ROS 消费端。"
            },
            {
              "label": "gazebo_labs/sensors.sdf",
              "language": "xml",
              "type": "complete",
              "sourceFile": "examples/gazebo_labs/sensors.sdf",
              "explanation": "独立 SDF 文件。世界只包含本地红板和静止传感器台架，固定安装和无噪声设定只用于检查接口。"
            },
            {
              "label": "gazebo_labs/bridge.yaml",
              "language": "yaml",
              "type": "complete",
              "sourceFile": "examples/gazebo_labs/bridge.yaml",
              "explanation": "五条单向数据映射，世界控制作为单独服务桥。frame_id 字符串和实际 TF 分开设置。"
            },
            {
              "label": "gazebo_labs/validate_sensors.py",
              "language": "python",
              "type": "complete",
              "sourceFile": "examples/gazebo_labs/validate_sensors.py",
              "explanation": "执行与回收进程，按时戳对齐消息，验证数据字段、图像与点云并留存报告和原始采样。"
            }
          ]
        }
      ],
      "appendExercises": [
        {
          "question": "世界控制回执成功后还需要看什么？",
          "answer": "等待相应窗口内的 /clock 和传感器采集时戳按预期冻结或推进。用单调秒限制等待。"
        },
        {
          "question": "多个 Gazebo 世界时，应怎样给同一 ROS 域提供 /clock？",
          "answer": "选择一个世界的限定时钟主题作为 ROS /clock 的唯一提供者。其他世界需要另设隔离域或时钟命名方案，避免同时驱动消费者。"
        }
      ]
    },
    "eco-perception-pipeline": {
      "appendSourceIds": [
        "sensor-image-contract",
        "sensor-image-calibration",
        "sensor-opencv",
        "sensor-scan-contract",
        "sensor-converters",
        "sensor-pcl-layout",
        "sensor-pcl-convert"
      ],
      "validation": "在本机 Gazebo Sim, version 8.15.0 与 Jazzy ros_gz_bridge 1.0.24，域 227/LOCALHOST、独立 Gazebo Transport 分区实际运行。真实桥接图像并使用 cv_bridge 4.1.0、OpenCV 4.6.0 处理，按二进制结构解码点云。范围为固定模拟相机、激光和实际桥接，GUI、实机、SLAM、Nav2 和底盘仿真由其他实验验收。",
      "appendSections": [
        {
          "title": "从模拟传感器核对采集、编码、内参与点字段",
          "paragraphs": [
            "把 Image、CameraInfo 和处理后的边缘图按 Header.stamp 精确配对，再核对光学 frame。96 像素宽、水平视场 π/3 rad 时，fx=96/(2·tan(π/6))≈83.14 px。读 CameraInfo 的 K 与本次采样配置交叉核对，K、D、R、P 的校正过程在相机资料中分别说明。",
            "RGB 输入经 cv_bridge 按显式编码转换成 BGR 数组。对这块红板，灰度换算压低了边界对比度；同一 Canny 阈值应用到红通道后检出竖边。输出 mono8 时保留原时戳和 frame，改像素颜色不需要重写采样位置或时间。阈值和选色结果仅限这个场景。",
            "扫描中心束和点云中心点应对应同一板面。点云解析必须先看 fields、point_step、row_step 与端序，再用偏移读坐标，过滤非有限点。PointCloud2 与 PCL 结构的转换也有实际复制边界。本地 pcl_conversions 的 toPCL 给数据数组赋值，moveToPCL 则交换数组，应用要根据调用的重载判断开销与输入所有权。",
            "本例 LiDAR 的 scan_time 和 time_increment 均为零，同时实测相邻采样 Header 间隔为 0.10 s。源码的桥转换没有从模拟器消息填入两个时长字段。对运动平台做去畸变前，应先确认驱动是否提供逐束时序及完整时间源。"
          ],
