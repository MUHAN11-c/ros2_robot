      "appendExercises": [
        {
          "question": "为何同阈值的灰度图和红通道会有不同边缘结果？",
          "answer": "灰度对通道加权，颜色边界可能只有很小的亮度梯度。先核 RGB/BGR 顺序，再按所需目标选择通道或改阈值。"
        },
        {
          "question": "点云有三个 FLOAT32 坐标，为何每点 32 B？",
          "answer": "点还可能有附加字段及对齐填充。字段的 offset 描述 x/y/z，每点和每行长度按 point_step、row_step 读取。"
        }
      ]
    },
    "eco-tf-frames": {
      "appendSourceIds": [
        "sensor-image-contract",
        "sensor-scan-contract",
        "sensor-bridge-config"
      ],
      "sections": {
        "6": {
          "appendParagraphs": [
            "仿真章另以真实桥接相机 Header 时戳查询 rig_base ← camera_optical_frame。光学单位点 (0, 0, 1) m 和同原点激光的 (1, 0, 0) m 都变到台架 (1, 0, 0) m。桥的 frame_id 覆盖只改标签，轴向关系由独立静态 TF 提供。模型章带安装平移的光学试验仍单独记录。"
          ]
        }
      },
      "appendExercises": [
        {
          "question": "只把 Gazebo 图像的 frame_id 改成 camera_optical_frame，会发生轴变换吗？",
          "answer": "改名不改变像素或三维轴。应为相机安装位置与光学旋转发布相应 TF，并用采样时戳查变换。"
        }
      ]
    },
    "qos": {
      "appendSourceIds": [
        "sensor-bridge-config",
        "sensor-clock-client"
      ],
      "appendSections": [
        {
          "title": "发现扫描话题后，分别核对匹配和接收",
          "paragraphs": [
            "在真实 Gazebo 桥的扫描话题上同时放两个订阅者。图上有 1 个 BEST_EFFORT 发布者；BEST_EFFORT 订阅匹配并收到 6 条，RELIABLE 订阅匹配数为 0 且零接收。报告记录了同一时间窗下的端点和接收计数。",
            "排查时分开记录话题名与类型、端点提供与请求 QoS、实际收到的采样数。把订阅策略对齐到模拟传感器只能解决传输匹配，Header、坐标系和数据质量仍要分别验证。"
          ],
          "bullets": [],
          "tables": [],
          "codeBlocks": []
        }
      ],
      "appendExercises": [
        {
          "question": "topic list 能看到 scan，但 RELIABLE 消费者一直空，先看什么？",
          "answer": "查实际提供端的可靠性和消费端请求值。若提供 BEST_EFFORT，可对照同窗 BEST_EFFORT 订阅的匹配和接收。"
        }
      ]
    },
    "time-bag": {
      "appendSourceIds": [
        "sensor-control",
        "sensor-clock-client"
      ],
      "sections": {
        "0": {
          "appendParagraphs": [
            "仿真章用真实 Harmonic 观察到暂停后 ROS 时间与五类采样时戳冻结，恢复后同步继续。软件定时器、录放与真实世界控制分别有证据。重放接入同一域前，先划清现场桥和回放的 /clock 发布职责；监测暂停或服务无响应时采用单调超时。"
          ]
        }
      },
      "appendExercises": [
        {
          "question": "Gazebo 暂停后，为何检查程序仍能在 0.40 秒结束？",
          "answer": "0.40 秒来自本机单调时钟。订阅的仿真时间保持不变，程序超时仍能继续计算。"
        }
      ]
    },
    "eco-slam-mapping": {
      "appendSourceIds": [
        "sensor-slam-input",
        "sensor-scan-contract",
        "sensor-converters"
      ],
      "sections": {
        "1": {
          "appendParagraphs": [
            "先用仿真章的实际扫描核第 20 束距离约 2.20 m、激光 frame 和采样时戳。SLAM Toolbox 配置还需独立指定 scan_topic、odom_frame、base_frame 与 map_frame。静止台架只检查入口；走廊、转弯和回环的建图效果需要有运动和里程计的不同数据。"
          ]
        }
      },
      "appendExercises": [
        {
          "question": "只有连续重复的静止墙面扫描，能否验收建图的回环？",
          "answer": "回环需要实际重访与时序观测。静止采样只适用于验收扫描结构、坐标与输入链路。"
        }
      ]
    },
    "eco-nav2-stack": {
      "appendSourceIds": [
        "sensor-nav2-filter",
        "sensor-scan-contract"
      ],
      "sections": {
        "2": {
          "appendParagraphs": [
            "Nav2 障碍层对 LaserScan 和 PointCloud2 分别使用 TF 消息过滤。先在仿真章验证实际 scan 的 QoS、采样时戳和 laser_link 到基座的变换，再核对代价地图实际配置的目标帧。远处无回波可能为无穷值，标记、清除、inf_is_valid 与距离参数分别检查。这里的传感器实测范围止于消费合同，代价地图输出与导航任务另验。"
          ]
        }
      },
      "appendExercises": [
        {
          "question": "激光 echo 有数据，代价地图仍无障碍，如何沿链路排查？",
          "answer": "查障碍层订阅的实际话题与数据类型，再按 Header.stamp 检查目标帧 TF，最后检查标记范围、清除和无穷距离规则。"
        }
      ]
    }
  },
