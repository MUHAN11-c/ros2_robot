<?xml version="1.0"?>
<!--
    URDF 语法 03_joint：车体 + 前后轮 + base_footprint 的完整底盘模型。
    joint 状态由 joint_state_publisher 发布，rviz2 中以 RobotModel 显示。
-->
<robot name="urdf02_car">
    <!-- 1.根坐标系 -->
    <link name="base_footprint">
        <visual>
            <geometry>
                <sphere radius="0.001"/>
            </geometry>
        </visual>
    </link>

    <!-- 2.车体 -->
    <link name="base_link">
        <visual>
            <geometry>
                <box size="0.5 0.3 0.1"/>
            </geometry>
            <origin xyz="0 0 0.1" rpy="0 0 0"/>
            <material name="blue">
                <color rgba="0.2 0.4 0.8 1.0"/>
            </material>
        </visual>
    </link>
    <joint name="base_link2base_footprint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0 0 0.075" rpy="0 0 0"/>
    </joint>

    <!-- 3.驱动轮(左侧) -->
    <link name="left_wheel">
        <visual>
            <geometry>
                <cylinder radius="0.075" length="0.04"/>
            </geometry>
            <origin xyz="0 0 0" rpy="1.5708 0 0"/>
            <material name="black">
                <color rgba="0.1 0.1 0.1 1.0"/>
            </material>
        </visual>
    </link>
    <joint name="left_wheel2base_link" type="continuous">
        <parent link="base_link"/>
        <child link="left_wheel"/>
        <origin xyz="-0.1 0.175 0.075" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>

    <!-- 4.驱动轮(右侧) -->
    <link name="right_wheel">
        <visual>
            <geometry>
                <cylinder radius="0.075" length="0.04"/>
            </geometry>
            <origin xyz="0 0 0" rpy="1.5708 0 0"/>
            <material name="black">
                <color rgba="0.1 0.1 0.1 1.0"/>
            </material>
        </visual>
    </link>
    <joint name="right_wheel2base_link" type="continuous">
        <parent link="base_link"/>
        <child link="right_wheel"/>
        <origin xyz="-0.1 -0.175 0.075" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>

    <!-- 5.万向轮(支撑轮) -->
    <link name="front_wheel">
        <visual>
            <geometry>
                <sphere radius="0.0375"/>
            </geometry>
            <material name="gray">
                <color rgba="0.5 0.5 0.5 1.0"/>
            </material>
        </visual>
    </link>
    <joint name="front_wheel2base_link" type="fixed">
        <parent link="base_link"/>
        <child link="front_wheel"/>
        <origin xyz="0.175 0 -0.0375" rpy="0 0 0"/>
    </joint>
</robot>
