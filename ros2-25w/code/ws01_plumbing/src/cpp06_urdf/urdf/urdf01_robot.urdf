<?xml version="1.0"?>
<!--
    URDF 语法 01_robot：一个最小可用的机器人模型(仅一个 link)。
    rviz2 中 Fixed Frame 设置为 base_footprint，添加 RobotModel 插件查看。
-->
<robot name="urdf01_robot">
    <link name="base_footprint">
        <visual>
            <geometry>
                <box size="0.5 0.3 0.1"/>
            </geometry>
            <origin xyz="0 0 0.05" rpy="0 0 0"/>
            <material name="blue">
                <color rgba="0.2 0.4 0.8 1.0"/>
            </material>
        </visual>
    </link>
</robot>
