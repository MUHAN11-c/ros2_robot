# 第25周 多车编队仿真环境：两台机器人(stage_ros2 多实例)
resolution 0.05
interval_sim 100
interval_realtime 100
update_gui 100

window
(
  size [ 700.000 700.000 ]
  center [ 0.000 0.000 ]
  scale 25.000
)

define laser ranger
(
  sensor
  (
    range [0.15 12.0]
    fov 360.0
    samples 360
    size [0.025 0.025 0.025]
  )
  color "black"
)

define robot position
(
  drive "diff"
  size [0.35 0.35 0.25]
  origin [0 0 0 0]
  odom_err [0.0 0.0 999999 0.0 0.0 999999]
  color "blue"
  laser ( pose [0.08 0 0 0] )
)

define wall model
(
  size [0.2 0.2 0.5]
  color "gray"
  block
  (
    points 4
    point [0 0]
    point [1 0]
    point [1 1]
    point [0 1]
    z [0 0.5]
  )
)

wall ( pose [5 0 0 90] size [10 0.2 0.5] name "wall_north" )
wall ( pose [-5 0 0 90] size [10 0.2 0.5] name "wall_south" )
wall ( pose [0 5 0 0] size [10 0.2 0.5] name "wall_east" )
wall ( pose [0 -5 0 0] size [10 0.2 0.5] name "wall_west" )

# 两台机器人：robot1 领航，robot2 跟随(编队)；
robot ( pose [0 1 0 0] name "robot1" color "blue" )
robot ( pose [0 -1 0 0] name "robot2" color "red" )
