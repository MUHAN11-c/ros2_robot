<?xml version="1.0"?>
<!-- Mycar 差速底盘模型：base_footprint / base_link / laser / camera，xacro 组织 -->
<robot name="mycar" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:property name="wheel_radius" value="0.0325"/>
    <xacro:property name="wheel_length" value="0.02"/>
    <xacro:property name="wheel_x" value="-0.03"/>
    <xacro:property name="wheel_y" value="0.0725"/>
    <xacro:property name="wheel_z" value="0.0325"/>

    <link name="base_footprint">
        <visual><geometry><sphere radius="0.001"/></geometry></visual>
    </link>

    <link name="base_link">
        <visual>
            <geometry><box size="0.18 0.12 0.05"/></geometry>
            <origin xyz="0 0 0.04" rpy="0 0 0"/>
            <material name="blue"><color rgba="0.2 0.4 0.8 1.0"/></material>
        </visual>
    </link>
    <joint name="base_link2base_footprint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0 0 ${wheel_radius + 0.025}" rpy="0 0 0"/>
    </joint>

    <xacro:macro name="wheel" params="name flag">
        <link name="${name}_wheel">
            <visual>
                <geometry><cylinder radius="${wheel_radius}" length="${wheel_length}"/></geometry>
                <origin xyz="0 0 0" rpy="1.5708 0 0"/>
                <material name="black"><color rgba="0.1 0.1 0.1 1.0"/></material>
            </visual>
        </link>
        <joint name="${name}_wheel2base_link" type="continuous">
            <parent link="base_link"/>
            <child link="${name}_wheel"/>
            <origin xyz="${wheel_x} ${flag * wheel_y} ${wheel_z}" rpy="0 0 0"/>
            <axis xyz="0 1 0"/>
        </joint>
    </xacro:macro>
    <xacro:wheel name="left" flag="1"/>
    <xacro:wheel name="right" flag="-1"/>

    <link name="laser">
        <visual>
            <geometry><cylinder radius="0.03" length="0.03"/></geometry>
            <material name="dark"><color rgba="0.3 0.3 0.3 1.0"/></material>
        </visual>
    </link>
    <joint name="laser2base_link" type="fixed">
        <parent link="base_link"/>
        <child link="laser"/>
        <origin xyz="0.06 0 0.085" rpy="0 0 0"/>
    </joint>

    <link name="camera">
        <visual>
            <geometry><box size="0.02 0.06 0.02"/></geometry>
            <material name="dark"><color rgba="0.3 0.3 0.3 1.0"/></material>
        </visual>
    </link>
    <joint name="camera2base_link" type="fixed">
        <parent link="base_link"/>
        <child link="camera"/>
        <origin xyz="0.09 0 0.07" rpy="0 0 0"/>
    </joint>
</robot>
